---
import type { Post } from '../lib/posts';
import { formatDate, postUrl, readingTime, tagUrl } from '../lib/posts';
import { responsivePostImage } from '../lib/responsive-images';
import { withBase } from '../lib/paths';

interface Props {
  post: Post;
  prominent?: boolean;
}
const { post, prominent = false } = Astro.props;
const hero = post.data.hero;
const responsiveHero = responsivePostImage(post);
---
<article class:list={['post-card', prominent && 'post-card--prominent']}>
  {hero && (
    <a class="post-card__image" href={postUrl(post)} tabindex="-1" aria-hidden="true">
      <img
        src={withBase(responsiveHero?.src ?? hero.src)}
        srcset={responsiveHero?.srcset}
        sizes="(min-width: 80rem) 44rem, (min-width: 52rem) 46vw, calc(100vw - 2rem)"
        alt=""
        width={hero.width}
        height={hero.height}
        loading={prominent ? 'eager' : 'lazy'}
        fetchpriority={prominent ? 'high' : 'auto'}
        decoding="async"
        style={`object-position:${hero.objectPosition ?? 'center'}`}
      />
    </a>
  )}
  <div class="post-card__body">
    <div class="post-meta">
      <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published, { month: 'short' })}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body ?? '')} min</span>
    </div>
    <h2><a href={postUrl(post)}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <ul class="tag-list" aria-label="Tags">
      {post.data.tags.slice(0, prominent ? 4 : 3).map((tag) => (
        <li><a href={tagUrl(tag)}>{tag}</a></li>
      ))}
    </ul>
  </div>
</article>
