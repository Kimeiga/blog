---
import { SITE } from '../config';
import { withBase } from '../lib/paths';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="shell site-footer__inner">
    <p class="site-footer__title">Hakan Alpay</p>
    <nav aria-label="Footer navigation">
      <a href={withBase('/about/')}>About</a>
      <a href={withBase('/rss.xml')}>RSS</a>
      <a href={SITE.repositoryUrl}>GitHub ↗</a>
      <a href={SITE.portfolioUrl}>Portfolio ↗</a>
    </nav>
    <div class="site-footer__previous">
      <p>Previous blogs</p>
      <nav aria-label="Previous blogs">
        <a href="https://oldblog.hakanalpay.com/">Life of Kimeiga ↗</a>
        <a href="https://kimeiga.wordpress.com/blog/">WordPress ↗</a>
        <a href="https://kimeiga.wordpress.com/lonely-cla/">Lonely-CLA ↗</a>
        <a href="https://deltastar.substack.com/archive?sort=new">delta galaxy ↗</a>
        <a href="https://github.com/Kimeiga/blog-old">Source ↗</a>
      </nav>
    </div>
    <p class="site-footer__fine">© {year} Hakan Alpay.</p>
  </div>
</footer>
