---
import { SITE } from '../config';
import { withBase } from '../lib/paths';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="shell site-footer__inner">
    <p class="site-footer__title">Hakan Alpay</p>
    <nav aria-label="Footer navigation">
      <a href={withBase('/about/')}>About</a>
      <a href={withBase('/rss.xml')}>RSS</a>
      <a href={SITE.repositoryUrl}>GitHub ↗</a>
      <a href={SITE.portfolioUrl}>Portfolio ↗</a>
    </nav>
    <p class="site-footer__fine">© {year} Hakan Alpay.</p>
  </div>
</footer>
