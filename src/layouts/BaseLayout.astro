---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import { absolute, withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  article?: boolean;
  published?: Date;
  updated?: Date;
  tags?: string[];
  noIndex?: boolean;
}
const {
  title = SITE.title,
  description = SITE.description,
  image,
  canonicalPath = Astro.url.pathname,
  article = false,
  published,
  updated,
  tags = [],
  noIndex = false,
} = Astro.props;
const fullTitle = title === SITE.title ? title : `${title} — Hakan Alpay`;
const canonical = absolute(canonicalPath.replace(/^\/blog/, ''));
const socialImage = image ? absolute(image) : absolute('/social-card.svg');
const structuredData = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: socialImage,
      datePublished: published?.toISOString(),
      dateModified: (updated ?? published)?.toISOString(),
      author: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
      publisher: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
      mainEntityOfPage: canonical,
      keywords: tags.join(', '),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.title,
      description: SITE.description,
      url: absolute('/'),
      author: { '@type': 'Person', name: SITE.author.name, url: SITE.author.url },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${absolute('/search/')}?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    };
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0c0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f1e8" media="(prefers-color-scheme: light)" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('hakan-blog-theme');
          document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="alternate" type="application/rss+xml" title="Hakan Alpay" href={withBase('/rss.xml')} />
    <link rel="alternate" type="application/feed+json" title="Hakan Alpay" href={withBase('/feed.json')} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Hakan Alpay" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={image ? description : 'Hakan Alpay blog'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {article && published && <meta property="article:published_time" content={published.toISOString()} />}
    {article && updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {article && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
