---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import { absolute, withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonicalPath?: string;
  article?: boolean;
  published?: Date;
  updated?: Date;
  tags?: string[];
  language?: string;
  pageType?: 'WebPage' | 'CollectionPage' | 'AboutPage' | 'SearchResultsPage';
  noIndex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  canonicalPath = Astro.url.pathname,
  article = false,
  published,
  updated,
  tags = [],
  language = SITE.language,
  pageType = 'WebPage',
  noIndex = false,
} = Astro.props;

const fullTitle = title === SITE.title ? title : `${title} — Hakan Alpay`;
const canonical = absolute(canonicalPath.replace(/^\/blog/, ''));
const home = absolute('/');
const socialSource = image && !/\.svg(?:$|[?#])/i.test(image) ? image : '/social-card.png';
const socialImage = absolute(socialSource);
const socialImageAlt = socialSource === image ? (imageAlt ?? description) : 'Hakan Alpay Blog';
const socialImageWidth = socialSource === image ? (imageWidth ?? 1200) : 1200;
const socialImageHeight = socialSource === image ? (imageHeight ?? 630) : 630;
const extension = new URL(socialImage).pathname.split('.').at(-1)?.toLowerCase();
const socialImageType = ({ avif: 'image/avif', jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp' } as Record<string, string>)[extension ?? ''] ?? 'image/jpeg';
const robots = noIndex
  ? 'noindex,nofollow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
const locale = language.toLowerCase() === 'en' ? SITE.locale : language.replace('-', '_');

const authorId = `${SITE.author.url}#person`;
const websiteId = `${home}#website`;
const blogId = `${home}#blog`;
const pageId = `${canonical}#webpage`;
const breadcrumbId = `${canonical}#breadcrumb`;
const imageObject = {
  '@type': 'ImageObject',
  url: socialImage,
  contentUrl: socialImage,
  width: socialImageWidth,
  height: socialImageHeight,
  caption: socialImageAlt,
};
const person = {
  '@type': 'Person',
  '@id': authorId,
  name: SITE.author.name,
  url: SITE.author.url,
  sameAs: [SITE.profileUrl],
};
const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  name: SITE.title,
  url: home,
  description: SITE.description,
  inLanguage: SITE.language,
  author: { '@id': authorId },
  publisher: { '@id': authorId },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${absolute('/search/')}?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
const blog = {
  '@type': 'Blog',
  '@id': blogId,
  name: SITE.title,
  url: home,
  description: SITE.description,
  inLanguage: SITE.language,
  isPartOf: { '@id': websiteId },
  author: { '@id': authorId },
  publisher: { '@id': authorId },
};
const breadcrumb = canonical === home ? undefined : {
  '@type': 'BreadcrumbList',
  '@id': breadcrumbId,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Blog', item: home },
    { '@type': 'ListItem', position: 2, name: title, item: canonical },
  ],
};
const page = article
  ? {
      '@type': 'BlogPosting',
      '@id': pageId,
      headline: title,
      description,
      url: canonical,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      image: imageObject,
      thumbnailUrl: socialImage,
      datePublished: published?.toISOString(),
      dateModified: (updated ?? published)?.toISOString(),
      inLanguage: language,
      isPartOf: { '@id': blogId },
      author: { '@id': authorId },
      publisher: { '@id': authorId },
      keywords: tags,
      ...(breadcrumb ? { breadcrumb: { '@id': breadcrumbId } } : {}),
    }
  : {
      '@type': pageType,
      '@id': pageId,
      name: fullTitle,
      headline: title,
      description,
      url: canonical,
      inLanguage: language,
      isPartOf: { '@id': websiteId },
      about: canonical === home ? { '@id': blogId } : undefined,
      primaryImageOfPage: imageObject,
      ...(breadcrumb ? { breadcrumb: { '@id': breadcrumbId } } : {}),
    };
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [person, website, blog, ...(breadcrumb ? [breadcrumb] : []), page],
};
---
<!doctype html>
<html lang={language} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0c0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f1e8" media="(prefers-color-scheme: light)" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('hakan-blog-theme');
          document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author.name} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical} />
    <link rel="author" href={SITE.author.url} />
    <link rel="sitemap" type="application/xml" href={absolute('/sitemap.xml')} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={absolute('/rss.xml')} />
    <link rel="alternate" type="application/feed+json" title={SITE.title} href={absolute('/feed.json')} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={String(socialImageWidth)} />
    <meta property="og:image:height" content={String(socialImageHeight)} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    {article && <meta property="article:author" content={SITE.author.url} />}
    {article && published && <meta property="article:published_time" content={published.toISOString()} />}
    {article && <meta property="article:modified_time" content={(updated ?? published)?.toISOString()} />}
    {article && tags[0] && <meta property="article:section" content={tags[0]} />}
    {article && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
