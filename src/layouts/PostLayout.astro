---
import type { Post } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Comments from '../components/Comments.astro';
import { absolute } from '../lib/paths';
import { formatDate, postSlug, postUrl, readingTime, tagUrl } from '../lib/posts';

interface Props {
  post: Post;
  headings: Array<{ depth: number; slug: string; text: string }>;
  previous?: Post;
  next?: Post;
}
const { post, headings, previous, next } = Astro.props;
const { data } = post;
const minutes = readingTime(post.body ?? '');
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
function legacyPublication(source: string) {
  const url = new URL(source);
  if (url.hostname.endsWith('wordpress.com')) return { preposition: 'on', name: 'WordPress' };
  if (url.hostname.endsWith('substack.com')) return { preposition: 'on', name: 'Substack' };
  if (url.hostname === 'github.com' && url.pathname.startsWith('/Kimeiga/blog-old/')) return { preposition: 'on', name: 'Life of Kimeiga' };
  if (url.hostname === 'github.com' && url.pathname.startsWith('/Kimeiga/leetcode/')) return { preposition: 'in', name: 'the LeetCode archive' };
  return { preposition: 'at', name: url.hostname.replace(/^www\./, '') };
}
const legacy = data.legacySource ? legacyPublication(data.legacySource) : undefined;
---
<BaseLayout
  title={data.title}
  description={data.description}
  image={data.hero?.src}
  canonicalPath={postUrl(post)}
  article
  published={data.published}
  updated={data.updated}
  tags={data.tags}
>
  <article class="post">
    <header class="post-header shell shell--article">
      <h1>{data.title}</h1>
      <p class="post-dek">{data.description}</p>
      <div class="post-byline">
        <span>By Hakan Alpay</span>
        <span aria-hidden="true">·</span>
        <time datetime={data.published.toISOString()}>{formatDate(data.published)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {data.updated && <><span aria-hidden="true">·</span><span>Updated {formatDate(data.updated, { month: 'short' })}</span></>}
      </div>
      <ul class="tag-list" aria-label="Tags">
        {data.tags.map((tag) => <li><a href={tagUrl(tag)}>{tag}</a></li>)}
      </ul>
    </header>

    {data.hero && (
      <div class="shell shell--wide post-hero">
        <Photo {...data.hero} eager />
      </div>
    )}

    <div class="post-grid shell shell--wide">
      {toc.length > 1 && (
        <aside class="toc" aria-label="Table of contents">
          <p>Contents</p>
          <ol>
            {toc.map((heading) => (
              <li class:list={[heading.depth === 3 && 'toc__nested']}><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </aside>
      )}
      <div class="prose" data-pagefind-body>
        {data.disclosure && <p class="editorial-note">{data.disclosure}</p>}
        <slot />
        {data.legacySource && legacy && (
          <p class="legacy-note">Originally published {legacy.preposition} {legacy.name}. <a href={data.legacySource}>View the source version ↗</a></p>
        )}
      </div>
    </div>

    <div class="shell shell--article post-tail">
      <div class="share-row">
        <span>Share</span>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(absolute(`/posts/${postSlug(post)}/`))}`}>LinkedIn ↗</a>
        <a href={`mailto:?subject=${encodeURIComponent(data.title)}&body=${encodeURIComponent(absolute(`/posts/${postSlug(post)}/`))}`}>Email ↗</a>
        <button type="button" class="copy-link" data-copy-link>Copy link</button>
      </div>
      <nav class="post-pagination" aria-label="Adjacent essays">
        {previous ? <a class="post-pagination__item" href={postUrl(previous)}><span>Older</span><strong>{previous.data.title}</strong></a> : <span />}
        {next ? <a class="post-pagination__item post-pagination__item--next" href={postUrl(next)}><span>Newer</span><strong>{next.data.title}</strong></a> : <span />}
      </nav>
      <Comments />
    </div>
  </article>
  <script is:inline>
    document.querySelector('[data-copy-link]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      if (!(button instanceof HTMLButtonElement)) return;
      try {
        await navigator.clipboard.writeText(location.href);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      window.setTimeout(() => { button.textContent = 'Copy link'; }, 1800);
    });
  </script>
</BaseLayout>
