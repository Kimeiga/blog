---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---
<BaseLayout title="Search" description="Search Hakan Alpay’s blog.">
  <div class="shell shell--article page-header page-header--search">
    <h1>Search</h1>
    <form class="search-form" role="search" data-search data-index={withBase('/search-index.json')}>
      <label for="search-input">Search posts</label>
      <div class="search-form__control">
        <input id="search-input" name="q" type="search" autocomplete="off" spellcheck="false" placeholder="Japan, CSS, perfectionism…" />
        <button class="button" type="submit">Search</button>
      </div>
    </form>
  </div>
  <section class="shell shell--article search-results" aria-labelledby="search-results-title">
    <h2 id="search-results-title" class="visually-hidden">Search results</h2>
    <p role="status" aria-live="polite" data-search-status>Enter a word or phrase.</p>
    <ol data-search-results></ol>
  </section>
  <script is:inline>
    (() => {
      const form = document.querySelector('[data-search]');
      if (!(form instanceof HTMLFormElement)) return;
      const input = form.querySelector('input[type="search"]');
      const status = document.querySelector('[data-search-status]');
      const results = document.querySelector('[data-search-results]');
      if (!(input instanceof HTMLInputElement) || !(status instanceof HTMLElement) || !(results instanceof HTMLOListElement)) return;
      let indexPromise;
      const normalize = (value) => String(value).normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const loadIndex = () => indexPromise ??= fetch(form.dataset.index).then((response) => {
        if (!response.ok) throw new Error(`Index returned ${response.status}`);
        return response.json();
      });
      const run = async (query, push = true) => {
        const clean = query.trim();
        results.replaceChildren();
        if (!clean) {
          status.textContent = 'Enter a word or phrase.';
          return;
        }
        status.textContent = 'Searching…';
        try {
          const posts = await loadIndex();
          const terms = normalize(clean).split(/\s+/).filter(Boolean);
          const ranked = posts.map((post) => {
            const title = normalize(post.title);
            const description = normalize(post.description);
            const tags = normalize(post.tags.join(' '));
            const body = normalize(post.body);
            if (!terms.every((term) => title.includes(term) || description.includes(term) || tags.includes(term) || body.includes(term))) return null;
            const score = terms.reduce((sum, term) => sum + (title.includes(term) ? 10 : 0) + (tags.includes(term) ? 6 : 0) + (description.includes(term) ? 3 : 0) + (body.includes(term) ? 1 : 0), 0);
            return { ...post, score };
          }).filter(Boolean).sort((a, b) => b.score - a.score || b.date.localeCompare(a.date));
          for (const post of ranked) {
            const item = document.createElement('li');
            const link = document.createElement('a');
            link.href = post.url;
            const title = document.createElement('h3');
            title.textContent = post.title;
            const description = document.createElement('p');
            description.textContent = post.description;
            const meta = document.createElement('span');
            meta.textContent = `${new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(new Date(post.date))} · ${post.tags.join(' · ')}`;
            link.append(title, description, meta);
            item.append(link);
            results.append(item);
          }
          status.textContent = `${ranked.length} result${ranked.length === 1 ? '' : 's'} for “${clean}”.`;
          if (push) history.replaceState(null, '', `${location.pathname}?q=${encodeURIComponent(clean)}`);
        } catch {
          status.textContent = 'Search failed.';
        }
      };
      form.addEventListener('submit', (event) => { event.preventDefault(); run(input.value); });
      input.addEventListener('focus', loadIndex, { once: true });
      const initial = new URLSearchParams(location.search).get('q');
      if (initial) { input.value = initial; run(initial, false); }
    })();
  </script>
</BaseLayout>
