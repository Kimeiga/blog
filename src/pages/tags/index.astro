---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allTags, getPublishedPosts, tagUrl } from '../../lib/posts';
const posts = await getPublishedPosts();
const tags = allTags(posts);
---
<BaseLayout title="Tags" description="Browse Hakan Alpay’s writing by subject." pageType="CollectionPage">
  <div class="shell shell--article page-header">
    <h1>Tags</h1>
  </div>
  <div class="shell shell--wide tag-directory">
    {tags.map((tag) => (
      <a class="tag-directory__item" href={tagUrl(tag.slug)}>
        <span>{tag.label}</span>
        <strong>{tag.count}</strong>
      </a>
    ))}
  </div>
</BaseLayout>
