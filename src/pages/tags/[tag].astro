---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { allTags, getPublishedPosts, slugifyTag } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return allTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.some((label) => slugifyTag(label) === tag.slug)),
    },
  }));
}
const { tag, posts } = Astro.props;
---
<BaseLayout title={`Tagged “${tag.label}”`} description={`${posts.length} essays and notes by Hakan Alpay tagged ${tag.label}.`}>
  <div class="shell shell--article page-header">
    <p class="eyebrow">Subject archive</p>
    <h1>{tag.label}</h1>
    <p>{posts.length} {posts.length === 1 ? 'piece' : 'pieces'} in this thread.</p>
  </div>
  <div class="shell shell--wide post-grid-list section-block section-block--tight">
    {posts.map((post) => <PostCard {post} />)}
  </div>
</BaseLayout>
