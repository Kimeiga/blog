---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { allTags, getPublishedPosts, slugifyTag } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return allTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.some((label) => slugifyTag(label) === tag.slug)),
    },
  }));
}
const { tag, posts } = Astro.props;
---
<BaseLayout title={tag.label} description={`Writing by Hakan Alpay tagged ${tag.label}.`} pageType="CollectionPage">
  <div class="shell shell--article page-header">
    <h1>{tag.label}</h1>
  </div>
  <div class="shell shell--wide post-grid-list section-block section-block--tight">
    {posts.map((post) => <PostCard {post} />)}
  </div>
</BaseLayout>
