---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { allTags, getPublishedPosts, tagUrl } from '../lib/posts';
import { withBase } from '../lib/paths';
const posts = await getPublishedPosts();
const [latest, ...rest] = posts;
const tags = allTags(posts).slice(0, 8);
---
<BaseLayout>
  <section class="home-hero shell shell--wide">
    <div class="home-hero__intro">
      <h1>Blog</h1>
      <p>Software, cities, economies, games, design, and language.</p>
      <div class="home-hero__actions">
        <a class="button" href={withBase('/archive/')}>Archive</a>
        <a class="button button--secondary" href={withBase('/search/')}>Search</a>
      </div>
    </div>
    {latest && <PostCard post={latest} prominent />}
  </section>

  <section class="topic-strip" aria-labelledby="topics-heading">
    <div class="shell shell--wide topic-strip__inner">
      <p id="topics-heading">Tags</p>
      <div>
        {tags.map((tag) => <a href={tagUrl(tag.slug)}>{tag.label}<sup>{tag.count}</sup></a>)}
      </div>
    </div>
  </section>

  <section class="shell shell--wide section-block" aria-labelledby="recent-heading">
    <div class="section-heading">
      <h2 id="recent-heading">Recent</h2>
      <a class="text-link" href={withBase('/archive/')}>All →</a>
    </div>
    <div class="post-grid-list">
      {rest.slice(0, 8).map((post) => <PostCard {post} />)}
    </div>
  </section>
</BaseLayout>
