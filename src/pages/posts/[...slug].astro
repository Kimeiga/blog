---
import { getPublishedPosts, postSlug, type Post } from '../../lib/posts';
import { dedupeImportedHero } from '../../lib/imported-content';
import PostLayout from '../../layouts/PostLayout.astro';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      previous: posts[index + 1],
      next: posts[index - 1],
    },
  }));
}

interface Props {
  post: Post;
  previous?: Post;
  next?: Post;
}
const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
const prepared = post.data.hero && post.id.startsWith('imported/')
  ? dedupeImportedHero(post.body ?? '', post.data.hero.src)
  : undefined;
const heroCaptionHtml = prepared?.changed ? prepared.captionHtml : undefined;
---
<PostLayout {post} {headings} {previous} {next} {heroCaptionHtml}>
  {prepared?.changed ? <Fragment set:html={prepared.html} /> : <Content />}
</PostLayout>
