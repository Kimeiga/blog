---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---
<BaseLayout title="About" description="About Hakan Alpay.">
  <div class="shell shell--article page-header">
    <h1>About</h1>
  </div>
  <article class="shell shell--article prose standalone-prose">
    <p class="lede">I’m Hakan Alpay, a software engineer in New York. I build software and games and write about software, cities, economies, design, language, and whatever I’m working on.</p>

    <p>Some posts are technical notes, some are research, and some are just things I wanted to think through. A few are AI-assisted.</p>

    <p><a href={SITE.repositoryUrl}>GitHub ↗</a></p>
  </article>
</BaseLayout>
