{
  "name": "hakan-alpay-blog",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/materialize-base64-assets.mjs && node scripts/import-legacy.mjs --if-missing && node scripts/validate-content.mjs && node scripts/generate-responsive-images.mjs",
    "build": "astro check && astro build",
    "postbuild": "node scripts/validate-seo.mjs",
    "preview": "astro preview",
    "new": "node scripts/new-post.mjs",
    "lint:content": "node scripts/validate-content.mjs",
    "verify:media": "node scripts/verify-deployed-media.mjs",
    "verify:seo": "node scripts/validate-seo.mjs",
    "images:responsive": "node scripts/generate-responsive-images.mjs",
    "audit:lighthouse": "node scripts/lighthouse-all.mjs",
    "sync:legacy": "node scripts/import-legacy.mjs --force",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/node": "^11.1.6",
    "lighthouse": "^13.4.1",
    "lightningcss": "^1.33.0",
    "sass": "^1.80.0",
    "sharp": "^0.33.5",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.33.5": true
  }
}
